# Which backend drives the agent loop: ollama | anthropic
LLM_PROVIDER=ollama

# --- ollama ---------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Must be a model with tool-calling support (llama3.1, qwen2.5-coder, mistral-nemo...)
OLLAMA_MODEL=llama3.1
# Context window. Ollama defaults to 4096, which silently truncates an agent
# transcript after a couple of tool results. Lower it if you run out of VRAM.
OLLAMA_CONTEXT=16384

# --- anthropic ------------------------------------------------------------
# Leave unset to fall back on an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Server-side fallback when a request is refused. Set to 0 to disable.
ANTHROPIC_FALLBACKS=1

# --- loop -----------------------------------------------------------------
# V2 feedback loop: the harness runs this after every landed edit and before the
# agent may finish. Set to an empty value to turn auto-verification off.
VERIFY_COMMAND=npm test

# --- skills (V3) ----------------------------------------------------------
# Library of SKILL.md conventions, as <name>/SKILL.md directories.
SKILLS_DIR=./skills
# How the task picks its skills: keyword (free, deterministic) | llm (one extra
# model call, understands paraphrase) | all (load everything) | off (catalog only,
# the model must ask via load_skill).
SKILL_ROUTER=keyword
# Cap on skills loaded before the first step. The cap is what keeps V3 meaningful.
MAX_SKILLS=3

# Directory the agent is allowed to touch, relative to this project
WORKSPACE=./workspace
# Hard stop so a confused model cannot spin forever
MAX_STEPS=20
# Seconds before run_command is killed
COMMAND_TIMEOUT=120
