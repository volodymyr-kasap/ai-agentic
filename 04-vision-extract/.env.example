# Required. Get one at https://openrouter.ai/keys — without it /tx/extract answers 503.
OPENROUTER_API_KEY=

# Any vision-capable OpenRouter model that honours response_format json_object.
VLM__MODEL=google/gemini-3-flash-preview
# Longest edge in px. Downscale-only, aspect ratio preserved.
VLM__IMAGE_SIZE=1536
# Seconds before the model request is aborted.
VLM__TIMEOUT=60

HOST=127.0.0.1
PORT=3000
